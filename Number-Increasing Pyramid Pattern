import java.util.*;
public class Main {
    public static void Pattern(int n)
    {
        int i, j;
        for (i = 1; i <= n; i++) {
            for (j = 1; j <= i; j++) {
                System.out.print(j + " ");
            }
            System.out.println();
        }
    }
    public static void main(String args[])
    {
        Scanner sc = new Scanner(System.in);
        System.out.print("enter the number: ");
        int data = sc.nextInt();
        System.out.println("THE PATTERN for  "+ data);
        Pattern(data);
    }
}



